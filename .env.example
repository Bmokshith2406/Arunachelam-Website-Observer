# Application
ENVIRONMENT=development
PORT=8080
ADMIN_API_KEY=replace-with-a-random-24-plus-character-management-key
CORS_ALLOWED_ORIGINS=[]

# Monitor behavior
MONITOR_ENABLED=True
POLL_INTERVAL_SECONDS=20
MONITOR_LEASE_SECONDS=90
FAILURE_ALERT_THRESHOLD=3

# The stable official HR&CE service identifiers are already encoded in these URLs.
HRCE_PRIMARY_URL=https://hrce.tn.gov.in/ticketing/service_collection.php?action=P&fees_slno=63716&group_id=4&rules_sid=45431&scode=21&sscode=1&target_type=&tid=20343
HRCE_FALLBACK_URL=https://annamalaiyar.hrce.tn.gov.in/ticketing/service_collection.php?action=P&fees_slno=63716&group_id=4&rules_sid=45431&scode=21&sscode=1&target_type=&tid=20343
BOOKING_LINK_URL=https://annamalaiyar.hrce.tn.gov.in/ticketing/service_collection.php?action=P&fees_slno=63716&group_id=4&rules_sid=45431&scode=21&sscode=1&target_type=&tid=20343
HRCE_REQUEST_TIMEOUT_SECONDS=10
HRCE_CONNECT_TIMEOUT_SECONDS=5
HRCE_MAX_ATTEMPTS_PER_URL=2
HRCE_RETRY_BASE_SECONDS=0.75
HRCE_MIN_RESPONSE_BYTES=2000

# Firestore. On Cloud Run, the project ID can normally be auto-detected.
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=arunachalam_ticket_monitor
FIRESTORE_STATE_DOCUMENT=swami_amman_special_abhishekam_2500
ALERT_CLAIM_TTL_SECONDS=120

# Gmail SMTP. Put SMTP_APP_PASSWORD in Secret Manager in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@gmail.com
SMTP_APP_PASSWORD=replace-with-16-character-google-app-password
SMTP_FROM_EMAIL=sender@gmail.com
SMTP_FROM_NAME=Arunachalam Ticket Monitor
SMTP_STARTTLS=True
SMTP_TIMEOUT_SECONDS=15
ALERT_RECIPIENTS='["recipient@gmail.com"]'
EMAIL_BURST_COUNT=10
EMAIL_BURST_GAP_SECONDS=0.5

